DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
PORT=3000
# Safety guard for test/integration/helpers/db.ts's truncateTables(): must be
# explicitly "true" for the integration test suite's afterEach to be allowed
# to TRUNCATE decisions/ruler_npcs/kingdoms against DATABASE_URL. Only set
# this to true against a dedicated test database/project -- never one that
# could ever hold real player data.
ALLOW_TEST_DB_TRUNCATE=false
